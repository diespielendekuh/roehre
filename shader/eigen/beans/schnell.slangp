// roehre: crt-beans-fast.slangp aus shader/fremd/mit/crt-beans (MIT, unverändert übernommen bis auf
// die Pfade), dahinter der eigene Pass helligkeit.slang (MIT OR Apache-2.0).
shaders = 4

//======== Linearize gamma.
shader0 = ../../fremd/mit/crt-beans/shaders/crt-beans/linearize.slang
alias0 = Linearized
mipmap_input0 = false
scale_type0 = source
scale0 = 1.0

//======== Draw the scanlines, handling interlacing and overscan.
shader1 = ../../fremd/mit/crt-beans/shaders/crt-beans/scanlines_fast_horizontal.slang
filter_linear1 = false
wrap_mode1 = clamp_to_border
mipmap_input1 = false
scale_type_x1 = viewport
scale_x1 = 1.0
scale_type_y1 = source
scale_y1 = 1.0

shader2 = ../../fremd/mit/crt-beans/shaders/crt-beans/scanlines_fast_vertical.slang
filter_linear2 = false
wrap_mode2 = clamp_to_border
mipmap_input2 = false
scale_type2 = viewport
scale2 = 1.0

//======== roehre: Helligkeitsausgleich (eigener Pass)
shader3 = helligkeit.slang
filter_linear3 = false
scale_type3 = source
scale3 = 1.0
